# Server
ANGELIX_ADMIN_TOKEN=        # required — token for admin endpoints (X-Admin-Token header)
PORT=8080
ANGELIX_DB=angelix.db       # SQLite file for member store
DEBUG=0

# Metrics backend: clickhouse (default) | duckdb
ANGELIX_METRICS_BACKEND=clickhouse

# ClickHouse
CLICKHOUSE_ADDR=localhost:9000
CLICKHOUSE_DB=angelix
CLICKHOUSE_USER=angelix
CLICKHOUSE_PASSWORD=angelix

# DuckDB (only used when ANGELIX_METRICS_BACKEND=duckdb)
DUCKDB_PATH=metrics.duckdb
